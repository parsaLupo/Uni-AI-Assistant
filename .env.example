# University Smart Assistant — environment template for the LOCAL release stack.
#
# Copy to `.env` and replace every __CHANGE_ME__ placeholder. The container
# entrypoint refuses to start if a placeholder, the development secret, or an
# empty database password survives into a release/local-demo run
# (backend/config/release_check.py).
#
# `scripts/init-env.ps1` does the copy and generates random local secrets for
# you. NEVER commit `.env`; it is gitignored.

# --- Deployment mode / local entry point -----------------------------------
# local-demo = production-like localhost stack over HTTP (Phase 16 scope).
# release    = future HTTPS deployment; requires secure cookies + HSTS.
DEPLOYMENT_MODE=local-demo
APP_PORT=8080
IMAGE_TAG=local

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=__CHANGE_ME__
DJANGO_DEBUG=false
DJANGO_LANGUAGE_CODE=fa
DJANGO_LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
# Same-origin through nginx, so no cross-origin browser client is allowed.
CORS_ALLOWED_ORIGINS=

# --- PostgreSQL + pgvector (the only supported database) --------------------
POSTGRES_DB=usa_db
POSTGRES_USER=usa_user
POSTGRES_PASSWORD=__CHANGE_ME__
# Compose builds DATABASE_URL for the `db` service. Set this only when running
# Django outside Docker (replace `db` with `localhost` in that case).
# DATABASE_URL=postgresql://usa_user:__CHANGE_ME__@db:5432/usa_db
DOCUMENT_STORAGE_ROOT=/app/media

# --- Cookies / transport ----------------------------------------------------
# The local demo intentionally serves HTTP on localhost (no certificates).
# These are explicit, not implicit defaults; a real `release` deployment must
# switch them to true/true/31536000.
COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# --- Authentication / limits / retention ------------------------------------
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
RATE_AUTH_IP=10/min
RATE_AUTH_REFRESH=30/min
RATE_AI_ASK=20/min
RATE_UPLOAD=10/min
RETENTION_CONVERSATION_DAYS=180

# --- Background processing (Celery + Redis) ---------------------------------
# `redis` is the Compose service name. Outside Docker use 127.0.0.1.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_CONCURRENCY=2

# --- AI provider -------------------------------------------------------------
# `mock` = deterministic offline answers (safe for demos and CI).
# `groq` = real provider; requires a key. Leave the key empty when using mock.
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
EMBEDDING_MODEL=

# --- Local demo data ---------------------------------------------------------
# seed_demo refuses to run unless DEMO_MODE=true. DEMO_PASSWORD is local-only,
# must be unique (>= 10 chars) and must not reuse the old public demo password.
# `manage.py seed` also reads DEMO_PASSWORD; without it, demo accounts are skipped.
DEMO_MODE=true
DEMO_PASSWORD=__CHANGE_ME__

# --- Local backup retention --------------------------------------------------
BACKUP_RETENTION_DAYS=14

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30

# --- Frontend ---------------------------------------------------------------
# Public build-time value; never put a secret in a VITE_* variable.
VITE_API_BASE_URL=/api/v1
