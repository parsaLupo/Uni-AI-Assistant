# Environment template — copy to `.env` for local use and never commit it.
#
# docs/09-deployment.md section 3 requires environment-based configuration and
# states that the variable names here must match what the application reads.
# Sections marked "(consumed in a later phase)" are declared now so the
# deployment contract does not change under Phase 01+ implementers.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Inside docker-compose the Vite dev server proxies to the backend by service
# name, so "backend" must be allowed in dev or proxied requests get 400
# DisallowedHost. Keep this list in sync with the defaults in docker-compose.yml.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_LOG_LEVEL=INFO
# User-facing language. Persian is the project default (AGENTS.md
# "Language & Localization"); API field names and error codes stay English.
DJANGO_LANGUAGE_CODE=fa

# --- Database (ADR-002: PostgreSQL + pgvector) ---
# Unset DATABASE_URL makes the backend fall back to a local SQLite file so the
# baseline can be verified without Docker.
POSTGRES_DB=usa_db
POSTGRES_USER=usa_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://usa_user:change-me@localhost:5432/usa_db

# --- Authentication (ADR-014; consumed by Phase 03) ---
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
# Secure cookie flags for refresh/CSRF/session cookies (docs/07 section 1).
# Defaults to true when DJANGO_DEBUG=false; set true explicitly behind HTTPS.
COOKIE_SECURE=false
# Auth rate limits (docs/07 section 2, OA-09): login/register per IP, refresh per user.
RATE_AUTH_IP=10/min
RATE_AUTH_REFRESH=30/min

# --- AI provider adapter (consumed in the AI/RAG phases; ADR-005, ADR-006) ---
# The key stays server-side and is never sent to React (AGENTS.md section 3).
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=

# --- Frontend ---
# Public value; it is baked into the browser bundle, so it must never contain a
# secret (AGENTS.md section 9).
VITE_API_BASE_URL=/api/v1
